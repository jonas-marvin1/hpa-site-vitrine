# Identifiants de la base : ne doivent jamais etre publies.
connexion.php

# Applications Laravel hebergees sous ce dossier : depot separe.
/my/
/test/

# Coquilles vides d'anciens sous-domaines.
/app/
/hpa_school_gestion/

# Documents deposes par les visiteurs : donnees personnelles.
# Le contenu est exclu, mais les .htaccess qui bloquent l'acces direct
# doivent rester versionnes : un deploiement sans eux rouvre les dossiers.
/cv/*
!/cv/.htaccess
/diplome/*
!/diplome/.htaccess

# Sauvegardes, exports, archives et journaux.
*.sql
*.bak
*.zip
*.log
.DS_Store
Thumbs.db
